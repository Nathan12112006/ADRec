# Local demo credentials only. Use distinct database names, including on one server.
# Host URLs use Compose's published port; Compose supplies postgres service URLs internally.
ADFLOW_DATABASE_URL=postgresql+psycopg://adflow:adflow@127.0.0.1:5432/adflow
ADFLOW_TEST_DATABASE_URL=postgresql+psycopg://adflow:adflow@127.0.0.1:5432/adflow_test
ADFLOW_LOG_LEVEL=INFO
# Seconds; connection and pool acquisition waits must be bounded.
ADFLOW_DB_CONNECT_TIMEOUT_SECONDS=5
ADFLOW_DB_POOL_TIMEOUT_SECONDS=5
ADFLOW_DB_STATEMENT_TIMEOUT_SECONDS=5
ADFLOW_DB_LOCK_TIMEOUT_SECONDS=3
ADFLOW_DB_POOL_SIZE=5
ADFLOW_DB_MAX_OVERFLOW=5
